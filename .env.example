# =============================================================================
# CrossLister environment configuration.
# Copy this file to `.env` and fill in your values. `.env` is git-ignored so
# secrets never leave your machine.
#
# Every model call goes through an OpenAI-compatible HTTP endpoint. For each
# capability you choose a MODE:
#   mock   -> deterministic offline stub, NO model / NO network (dev & tests)
#   local  -> your own vLLM server (see docker-compose.yml for a template)
#   api    -> any hosted OpenAI-compatible endpoint (set the *_API_BASE/KEY)
# =============================================================================

# -- Application -----------------------------------------------------------
# Verbose logging when true.
DEBUG=false

# -- 1. Vision model: extracts selling points from product images ----------
# Model: Qwen/Qwen2.5-VL-7B-Instruct (multimodal).
# local = self-hosted vLLM, api = hosted OpenAI-Vision compatible endpoint,
# mock  = offline stub.
VISION_MODE=mock
# Base URL of the OpenAI-compatible server, e.g. http://localhost:8000/v1
VISION_API_BASE=http://localhost:8000/v1
VISION_API_KEY=EMPTY
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_MAX_IMAGES=5
VISION_TIMEOUT_S=120

# -- 2. Text LLM: listing generation + compliance + translation ------------
# Model: Qwen/Qwen2.5-7B-Instruct (or any strong instruct model).
# api = hosted/self-hosted OpenAI chat endpoint, mock = offline stub.
LLM_MODE=mock
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TIMEOUT_S=120

# -- 3. Embeddings: vectorize platform rules + queries for RAG --------------
# Model: Qwen/Qwen3-Embedding-0.6B. Served via an OpenAI-compatible /embeddings endpoint
# (vLLM or a text-embeddings-inference server). mock = offline hash embedder.
EMBEDDING_MODE=mock
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_LOCAL_MODEL_PATH=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_BASE=http://localhost:8000/v1
EMBEDDING_API_KEY=EMPTY

# -- RAG store --------------------------------------------------------------
# Number of rule chunks retrieved per query.
RAG_TOP_K=4
# Where the Chroma vector store persists (embedded, no separate server).
# CHROMA_PERSIST_DIR=./data/chroma
# Directory holding the platform rule documents (*.md).
# PLATFORM_RULES_DIR=./data/platform_rules

# -- Compliance guardrails --------------------------------------------------
# Max generate->compliance retry loops before giving up.
MAX_COMPLIANCE_RETRIES=3
